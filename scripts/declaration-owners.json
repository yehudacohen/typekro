  "rootEntry": {
    "$comment": "Core plus the integrations src/factories/index.ts re-exported when per-owner budgets were introduced (alchemy is reached through core deployment types). Do not add new integrations here: ship them as their own subpath export.",
    "export": ".",
    "allowedOwners": [
      "core",
      "alchemy",
      "apisix",
      "cert-manager",
      "cilium",
      "clickstack",
      "envoy-ai-gateway",
      "external-dns",
