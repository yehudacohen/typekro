      "traefik"
    ]
  },
  "allowedEdges": [
    {
      "from": "apisix",
      "to": "cert-manager",
      "reason": "Borrows generic Kubernetes helper types (Affinity, EnvVar, Toleration, ...) from cert-manager; move them into core."
    },
    {
      "from": "core",
      "to": "alchemy",
      "reason": "Deployment option types reference the alchemy scope types."
    },
    {
      "from": "envoy-ai-gateway",
      "to": "gateway-api",
      "reason": "Envoy AI Gateway builds on Gateway API resources."
    },
    {
      "from": "external-dns",
      "to": "cert-manager",
      "reason": "Borrows generic Kubernetes helper types (Affinity, EnvVar, Toleration, ...) from cert-manager; move them into core."
    },
    {
      "from": "ory",
      "to": "cert-manager",
      "reason": "Borrows generic Kubernetes helper types (Affinity, EnvVar, Toleration, ...) from cert-manager; move them into core."
    },
    {
      "from": "traefik",
      "to": "cert-manager",
      "reason": "Borrows generic Kubernetes helper types (Affinity, EnvVar, Toleration, ...) from cert-manager; move them into core. traefikTlsCertificate also returns a cert-manager Certificate by design."
    },
    {
      "from": "traefik",
      "to": "gateway-api",
      "reason": "Traefik's Gateway API provider wraps gateway-api resources."
    },
    {
      "from": "webapp",
      "to": "valkey",
      "reason": "The webapp composition can provision a Valkey cache."
    }
  ]
